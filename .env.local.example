# Public URL of the deployed app, e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: use service role ONLY on server. Never expose it as NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Instagram Login (Meta Developer App)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
# Current Graph API version; verify in Meta dashboard before production.
INSTAGRAM_GRAPH_VERSION=v27.0

# Gemini AI caption generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Protect scheduled publishing endpoint
CRON_SECRET=replace-with-a-long-random-secret

# Threads API (Meta Threads use case)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/api/threads/callback
